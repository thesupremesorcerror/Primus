# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.
# docker-compose automatically reads .env from this directory.

# Postgres
POSTGRES_PASSWORD=your-local-postgres-password

# Gemini API (get a key at https://ai.google.dev)
GEMINI_API_KEY=your-gemini-api-key-here

# JWT signing secret — must be at least 32 characters.
# Generate one with:
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=replace-with-a-real-random-32-plus-character-secret